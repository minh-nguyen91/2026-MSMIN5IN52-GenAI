{
  "name": "groupe-owui-qa",
  "version": "0.1.0",
  "private": true,
  "description": "F1 — QA E2E d'Open WebUI (Playwright, multi-tenant, CI)",
  "type": "module",
  "scripts": {
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "env:reset": "docker compose down -v",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "test": "playwright test --project=owui",
    "test:headed": "playwright test --project=owui --headed",
    "test:ui": "playwright test --ui",
    "test:baseline": "playwright test --project=baseline",
    "flakiness": "node scripts/flakiness.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.7",
    "typescript": "^7.0.2"
  }
}
