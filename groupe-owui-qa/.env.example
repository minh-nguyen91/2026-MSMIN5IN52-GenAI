# Copier vers .env :  cp .env.example .env
# Ne jamais commiter .env : il contient les identifiants réels.

# Tenant A (instance principale) et tenant B (tests d'isolation)
OWUI_URL=http://localhost:3000
OWUI_TENANT2_URL=http://localhost:3001

# Compte admin créé sur les deux tenants par `npm run seed`
OWUI_EMAIL=
OWUI_PASSWORD=

# Optionnel : vrai fournisseur à la place du LLM simulé (budget cible < 5 €)
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
